#################################################################
#    Classes
#################################################################

###  http://data.sparna.fr/ontologies/sparnatural-config-core#SparnaturalClass
<http://data.sparna.fr/ontologies/sparnatural-config-core#SparnaturalClass> rdf:type owl:Class .


###  http://www.w3.org/2000/01/rdf-schema#Literal
rdfs:Literal rdf:type owl:Class .


###  https://francearchives.gouv.fr/sparnatural#Activite
:Activite rdf:type owl:Class ;
          rdfs:subClassOf <http://data.sparna.fr/ontologies/sparnatural-config-core#SparnaturalClass> ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#defaultLabelProperty> :rdfsLabel ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#faIcon> "ri-briefcase-line" ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#ActivityType>" ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#tooltip> "Fonction exercée par une personne ou une institution."@fr ,
                                                                             "Function performed by a person or an institution."@en ,
                                                                             "Funktion, die von einer Person oder einer Institution ausgeübt wird."@de ,
                                                                             "Función desempeñada por una persona o institución."@es ;
          rdfs:label "Activity"@en ,
                     "Activité"@fr ,
                     "Tätigkeit"@de ,
                     "Actividad"@es .


###  https://francearchives.gouv.fr/sparnatural#Archives
:Archives rdf:type owl:Class ;
          rdfs:subClassOf <http://data.sparna.fr/ontologies/sparnatural-config-core#SparnaturalClass> ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#defaultLabelProperty> :aPourIntitule ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#faIcon> "ri-article-line" ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#order> 1 ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> """<https://www.ica.org/standards/RiC/ontology#RecordResource>;
<https://www.ica.org/standards/RiC/ontology#isOrWasIncludedIn> []""" ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#tooltip> "Description des dossiers, registres et documents d'archives contenant des informations permettant de les identifier et de les consulter."@fr ,
                                                                             "Description of files, registers and documents with information allowing their identification and access."@en,
                                                                             "Beschreibung von Akten, Registern und Archivdokumente, die Informationen enthalten, die es ermöglichen, sie zu identifizieren und einzusehen."@de ,
                                                                             "Descripción de los expedientes, registros y documentos de archivo que contengan información que permite identificarlos y consultarlos."@es ;
          rdfs:label "Archival document"@en ,
                     "Document d'archives"@fr ,
                     "Archivdokument"@de ,
                     "Documento de archivo"@es .


###  https://francearchives.gouv.fr/sparnatural#Contenu
:Contenu rdf:type owl:Class ;
         rdfs:subClassOf rdfs:Literal ;
         <http://data.sparna.fr/ontologies/sparnatural-config-core#faIcon> "ri-file-search-line" ;
         <http://data.sparna.fr/ontologies/sparnatural-config-core#tooltip> "Description détaillée et informations complémentaires sur le document d’archives."@fr ,
                                                                            "Detailed description or additionnal information on the archival documents."@en ,
                                                                            "Ausführliche Beschreibung und weitere Informationen über das Archivdokument."@de ,
