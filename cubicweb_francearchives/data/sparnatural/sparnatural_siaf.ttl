                    <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
                    <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
                    <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasOrHadMember>" ;
                    rdfs:label "a pour membre"@fr ,
                               "has member"@en ,
                               "hat als Mitglied"@de ,
                               "tiene como miembro"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourOccupation
:aPourOccupation rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#ListProperty> ;
                 rdfs:range :Occupation ;
                 <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
                 <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
                 <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasOrHadOccupationOfType>" ;
                 <http://data.sparna.fr/ontologies/sparnatural-config-core#tooltip> "Connects a person and the activity he occupies."@en ,
                                                                                    "Relie une personne et l'activité qu'elle occupe."@fr ;
                 <http://data.sparna.fr/ontologies/sparnatural-config-datasources#datasource> :list_rdfslabel_range_alpha ;
                 rdfs:label "a pour activité"@fr ,
                            "has occupation"@en ,
                            "hat für Tätigkeit"@de ,
                            "tiene como actividad"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourParent
:aPourParent rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
             rdfs:domain :Personne ;
             rdfs:range :Personne ;
             <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
             <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
             <http://data.sparna.fr/ontologies/sparnatural-config-core#order> "1"^^xsd:int ;
             <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#isChildOf>" ;
             rdfs:label "a pour parent"@fr ,
                        "has parent"@en ,
                        "hat Eltern"@de ,
                        "tiene como padre/madre"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourSujet
:aPourSujet rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#AutocompleteProperty> ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Archives
                                        :Inventaire
                                      )
                        ] ;
            rdfs:range :Theme ;
            <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
            <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
            <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasOrHadSubject>" ;
            <http://data.sparna.fr/ontologies/sparnatural-config-datasources#datasource> :search_rdfs_label_contains_only_range ;
            rdfs:label "a pour sujet"@fr ,
                       "has subject"@en ,
                       "hat als Thema"@de ,
                       "tiene el tema"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourTypeDOrganisation
:aPourTypeDOrganisation rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#ListProperty> ;
