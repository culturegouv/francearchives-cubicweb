:query_list_label_count_langfr rdf:type owl:NamedIndividual ,
                                        <http://data.sparna.fr/ontologies/sparnatural-config-datasources#SPARQLQuery> ;
                               <http://data.sparna.fr/ontologies/sparnatural-config-datasources#queryString> """SELECT ?uri ?count (CONCAT(STR(?theLabel), ' (', STR(?count), ')') AS ?label)
WHERE {
{
  SELECT DISTINCT ?uri (COUNT(?domain) AS ?count)
  WHERE {
    ?domain a $domain .
    ?domain $property ?uri .
    FILTER(isIRI(?uri))
    # Note how the range criteria is not used in this query
  }
  GROUP BY ?uri
}
?uri $labelPath ?theLabel .
FILTER(lang(?theLabel) = \"\" || lang(?theLabel) = $lang || lang(?theLabel) = \"fr\")
}
ORDER BY DESC(?count) UCASE(?label)
LIMIT 500""" .


