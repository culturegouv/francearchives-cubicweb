###  https://francearchives.gouv.fr/sparnatural#query_search_bifcontains
:query_search_bifcontains rdf:type owl:NamedIndividual ,
                                   <http://data.sparna.fr/ontologies/sparnatural-config-datasources#SPARQLQuery> ;
                          <http://data.sparna.fr/ontologies/sparnatural-config-datasources#queryString> """SELECT DISTINCT ?uri ?label
 WHERE {
  ?domain a $domain .
  ?domain $property ?uri .
  ?uri a $range .
  ?uri $labelPath ?label .
  ?label <http://www.openlinksw.com/schemas/bif#contains> \"'$key'\" . 
} 
ORDER BY UCASE(?label)
LIMIT 50""" .


###  https://francearchives.gouv.fr/sparnatural#query_search_label_contains_langfr
:query_search_label_contains_langfr rdf:type owl:NamedIndividual ,
                                             <http://data.sparna.fr/ontologies/sparnatural-config-datasources#SPARQLQuery> ;
                                    <http://data.sparna.fr/ontologies/sparnatural-config-datasources#queryString> """SELECT DISTINCT ?uri ?label
WHERE {
  ?domain a $domain .
  ?domain $property ?uri .
  ?uri a $range .
  ?uri $labelPath ?label .
  FILTER(CONTAINS(LCASE(STR(?label)), LCASE(\"$key\"))) 
} 
ORDER BY UCASE(?label)
LIMIT 50""" .


