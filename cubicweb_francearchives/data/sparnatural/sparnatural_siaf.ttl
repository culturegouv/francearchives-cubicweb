@prefix : <https://francearchives.gouv.fr/sparnatural#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://francearchives.gouv.fr/sparnatural> .

<https://francearchives.gouv.fr/sparnatural> rdf:type owl:Ontology ;
                                              owl:imports <http://data.sparna.fr/ontologies/sparnatural-config-core> ,
                                                          <http://data.sparna.fr/ontologies/sparnatural-config-datasources> .

#################################################################
#    Annotation properties
#################################################################

###  http://data.sparna.fr/ontologies/sparnatural-config-core#beginDateProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#beginDateProperty> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#defaultLabelProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#defaultLabelProperty> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation
<http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional
<http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#endDateProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#endDateProperty> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#exactDateProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#exactDateProperty> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#faIcon
<http://data.sparna.fr/ontologies/sparnatural-config-core#faIcon> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#order
<http://data.sparna.fr/ontologies/sparnatural-config-core#order> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString
<http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#tooltip
<http://data.sparna.fr/ontologies/sparnatural-config-core#tooltip> rdf:type owl:AnnotationProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-datasources#queryTemplate
<http://data.sparna.fr/ontologies/sparnatural-config-datasources#queryTemplate> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://data.sparna.fr/ontologies/sparnatural-config-core#AutocompleteProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#AutocompleteProperty> rdf:type owl:ObjectProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#ListProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#ListProperty> rdf:type owl:ObjectProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> rdf:type owl:ObjectProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#SearchProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#SearchProperty> rdf:type owl:ObjectProperty ;
                                                                          rdfs:range :Label .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#StringEqualsProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#StringEqualsProperty> rdf:type owl:ObjectProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#TimeProperty-Date
<http://data.sparna.fr/ontologies/sparnatural-config-core#TimeProperty-Date> rdf:type owl:ObjectProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#TimeProperty-Year
<http://data.sparna.fr/ontologies/sparnatural-config-core#TimeProperty-Year> rdf:type owl:ObjectProperty .


###  http://data.sparna.fr/ontologies/sparnatural-config-core#TreeProperty
<http://data.sparna.fr/ontologies/sparnatural-config-core#TreeProperty> rdf:type owl:ObjectProperty .


###  https://francearchives.gouv.fr/sparnatural#aInstitutionParente
:aInstitutionParente rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
                     rdfs:domain :Organization ;
                     rdfs:range :Organization ;
                     <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
                     <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
                     <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#isOrWasSubordinateTo>+" ;
                     rdfs:label "dépend de"@fr ,
                                "has superior"@en ,
                                "hängt von"@de ,
                                "depende de"@es .


###  https://francearchives.gouv.fr/sparnatural#aInstitutionSubordonnee
:aInstitutionSubordonnee rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
                         rdfs:domain :Organization ;
                         rdfs:range :Organization ;
                         <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
                         <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
                         <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasOrHadSubordinate>+" ;
                         rdfs:label "a autorité sur"@fr ,
                                    "has subordinate"@en ,
                                    "hat Autorität über"@de ,
                                    "tiene autoridad sobre"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourActivite
:aPourActivite rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#ListProperty> ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :Organization
                                           :Personne
                                         )
                           ] ;
               rdfs:range :Activite ;
               <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
               <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
               <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#performsOrPerformed> / <https://www.ica.org/standards/RiC/ontology#hasActivityType>" ;
               <http://data.sparna.fr/ontologies/sparnatural-config-datasources#datasource> :list_rdfslabel_no_domain_alpha ;
               rdfs:label "a pour activité"@fr ,
                          "has activity"@en ,
                          "hat für Tätigkeit"@de ,
                          "tiene como actividad"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourAdelphe
:aPourAdelphe rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
              rdfs:domain :Personne ;
              rdfs:range :Personne ;
              <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
              <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
              <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasSibling>" ;
              rdfs:label "a pour frère/soeur"@fr ,
                         "has sibling"@en ,
                         "hat Bruder/Schwester/Gechwister"@de ,
                         "tiene como hermano/hermana"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourContenu
:aPourContenu rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#VirtuosoSearchProperty> ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Archives
                                          :Inventaire
                                        )
                          ] ;
              rdfs:range :Contenu ;
              <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
              <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
              <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#scopeAndContent>" ;
              <http://data.sparna.fr/ontologies/sparnatural-config-datasources#queryTemplate> <http://data.sparna.fr/ontologies/sparnatural-config-datasources#query_search_label_bifcontains> ;
              rdfs:label "a pour contenu"@fr ,
                         "has content"@en ,
                         "hat als Inhalt"@de ,
                         "tiene como contenido"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourCote
:aPourCote rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#StringEqualsProperty> ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Archives
                                       :Inventaire
                                     )
                       ] ;
           rdfs:range :Cote ;
           <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
           <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
           <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#identifier>" ;
           rdfs:label "a pour cote"@fr ,
                      "has reference code"@en ,
                      "hat als Signatur"@de ,
                      "tiene la signatura"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourEnfant
:aPourEnfant rdf:type owl:ObjectProperty ;
