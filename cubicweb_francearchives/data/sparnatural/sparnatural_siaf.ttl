###  https://francearchives.gouv.fr/sparnatural#aRicoName
:aRicoName rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#VirtuosoSearchProperty> ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :Family
                                       :Lieu
                                       :Organization
                                       :Personne
                                       :Theme
                                     )
                       ] ;
           rdfs:range :Nom ;
           <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
           <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
           <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<http://www.w3.org/2000/01/rdf-schema#label>" ;
           rdfs:label "a pour nom"@fr ,
                      "has name"@en ,
                      "hat Name"@de ,
                      "tiene el nombre"@es .


###  https://francearchives.gouv.fr/sparnatural#a_une_reproduction
:a_une_reproduction rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Archives
                                                :Inventaire
                                              )
                                ] ;
                    rdfs:range :ReproductionNumerique ;
                    <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasInstantiation>/<http://purl.org/dc/terms/source>" ;
                    rdfs:label "a pour copie numérique"@fr ,
                               "has digital surrogate"@en ,
                               "hat als digitale Kopie"@de ,
                               "tiene como copia digital"@es .


###  https://francearchives.gouv.fr/sparnatural#concerne
:concerne rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
          owl:inverseOf :estConcernePar ;
          rdfs:domain [ rdf:type owl:Class ;
                        owl:unionOf ( :Archives
                                      :Inventaire
                                    )
                      ] ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( :Family
                                     :Lieu
                                     :Organization
                                     :Personne
                                   )
                     ] ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasOrHadSubject>"@fr ;
          <http://data.sparna.fr/ontologies/sparnatural-config-core#tooltip> "Relie une ressource archivistique à un agent ou à un lieu qui est concerné par cette ressource."@fr ;
          rdfs:label "a pour sujet"@fr ,
                     "has subject"@en ,
                     "hat als Thema"@de ,
                     "tiene el tema"@es .


