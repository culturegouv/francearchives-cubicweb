                         <http://data.sparna.fr/ontologies/sparnatural-config-datasources#datasource> :list_rdfslabel_no_domain_alpha ;
                         rdfs:label "held at"@en ,
                                    "est conservé à"@fr ,
                                    "wird aufbewahrt bei"@de ,
                                    "se conserva en"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourMembre
:aPourMembre rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
             owl:inverseOf :estMembreDe ;
             rdfs:domain :Organization ;
             rdfs:range :Personne ;
             <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
             <http://data.sparna.fr/ontologies/sparnatural-config-core#enableOptional> "true"^^xsd:boolean ;
             <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#isAgentAssociatedWithAgent>" ;
             rdfs:label "a pour membre"@fr ,
                        "has member"@en ,
                        "hat als Mitglied"@de ,
                        "tiene como miembro"@es .


###  https://francearchives.gouv.fr/sparnatural#aPourMembreFamille
:aPourMembreFamille rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://data.sparna.fr/ontologies/sparnatural-config-core#NonSelectableProperty> ;
