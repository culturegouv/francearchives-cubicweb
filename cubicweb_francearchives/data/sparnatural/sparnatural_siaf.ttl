                        <http://data.sparna.fr/ontologies/sparnatural-config-core#enableNegation> "true"^^xsd:boolean ;
                        <http://data.sparna.fr/ontologies/sparnatural-config-core#sparqlString> "<https://www.ica.org/standards/RiC/ontology#hasOrHadLegalStatus>" ;
                        <http://data.sparna.fr/ontologies/sparnatural-config-datasources#datasource> :list_rdfslabel_with_range_alpha ;
                        rdfs:label "a pour type d'institution"@fr ,
                                   "has organization type"@en ,
                                   "hat als Institutionstyp"@de ,
                                   "tiene como tipo de institución"@es .


