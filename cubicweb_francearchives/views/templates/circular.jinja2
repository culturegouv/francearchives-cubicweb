{% from "./mixins.jinja2" import mixed_values_horizontal, content_metadata -%}
{%- set lang_attr='lang="{}"'.format(entity.lang) if entity.lang != lang else "" -%}
<section class="fr-container">
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--center">
    <div id="{{ entity.cw_etype.lower() }}-{{ entity.eid }}" class="fr-col-12 fr-col-lg-8 fr-mb-md-8v">
      <div class="fr-mb-8v fr-mb-md-12v" {{ lang_attr }}>
        <h1>{{ entity.dc_title()|e }}</h1>
      </div>
      <div class="fr-col-12 fr-mb-12v">
        {{ content_metadata(metadata, _) }}
      </div>
      <div class="fr-col-12 fr-mb-16v">
        {{ mixed_values_horizontal(main_props, lang_attr, _) }}
      </div>
    </div>
  </div>
</section>
