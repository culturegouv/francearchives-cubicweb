{% from "./mixins.jinja2" import section_themes_cards, section_themes_tuiles -%}
{% if entities %}
<div class="fr-my-md-12v d-print-none">
  <div class="fr-container">
    <div class="fr-grid-row fr-grid-row--gutters">
        <div class="fr-col-12">
        <h2 class="fr-h3">{{ _("Explore themes")}}</h2>
        </div>
    </div>
    <div class="fr-grid-row fr-grid-row--gutters">
      <div class="fr-col-12">
        <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--center">
          {%- for entity in entities -%}
          <div class="fr-col-12 fr-col-md-4">
            <div class="fr-card fa-card-theme fr-enlarge-link">
              <div class="fr-card__body">
                <div class="fr-card__content">
                  <h3 class="fr-card__title fr-h6">
                    <a class="fr-card__link" href="{{ entity.url }}">{{ entity.label|e }}</a>
                  </h3>
                </div>
              </div>
              {%- if entity.image_src -%}
              <div class="fr-card__header">
                <div class="fr-card__img">
                  <img class="fr-responsive-img" src="{{ entity.image_src }}" alt="" >
                </div>
              </div>
              {%- endif -%}
            </div>
          </div>
          {#
          <div class="fr-col-12 fr-col-md-3">
            <div class="fr-card fr-enlarge-link">
              <div class="fr-card__body">
                <div class="fr-card__content">
                  <h3 class="fr-card__title fr-h6">
                    <a class="fr-card__link" href="{{ entity.url }}">{{ entity.label|e }}</a>
                  </h3>
                </div>
              </div>
              {%- if entity.image_src -%}
              <div class="fr-card__header">
                <div class="fr-card__img">
                  <img class="fr-responsive-img" src="{{ entity.image_src }}" alt="" >
                </div>
              </div>
              {%- endif -%}
            </div>
          </div> #}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}
