{% from "./mixins.jinja2" import document_values,  list, sharelinks, content_metadata -%}
{%- set lang_attr='lang="{}"'.format(entity.lang) if entity.lang != lang else "" -%}
<section class="fr-container fa-inventory">
  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fa-inventory-content fr-col-12 fr-col-lg-7 fr-col-offset-lg-1--right">
      <div class="fa-inventory-content__title fr-mb-12v" {{ lang_attr }}>
        <h1>{{ entity.dc_title() }}</h1>
      </div>
      {%- if editable -%}
      <div class="fr-col-12 {%- if i18n_links|length > 0 %} fr-col-md-10{%- endif -%}">
          {{ content_metadata(notice_metadata, _) }}
          </div>
      {%- endif -%}
      <div class="fr-mb-8v fr-pt-6v fa-inventory-content__context">
         {%- for label, values in metadata -%}
         <div class="fr-grid-row fr-grid-row--gutters">
          <h2 class="fr-col-md-5 fr-text--md fr-text--bold fr-my-0">{{ label }}</h2>
          <div class="fr-col-md-7 fr-mb-2v">
          {%- if not values | is_list %}
            <p class="fr-mb-0" {{ lang_attr }}>{{ values }}</p>
          {% else %}
            {{ list(values, "", lang_attr, _) }}
          {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      </div>
      <div class="fr-col-12 fr-mb-18v">
        {{ document_values(main_props, lang_attr ) }}
      </div>
    </div>
    <div id="eac-context-actions" class="fr-col-12 fr-col-lg-4">
      <div class="fa-inventory-utils">
        <div class="fa-inventory-utils__address">
         <h2 class="fr-h4">{{ _('Notice author ') }}</h2>
          <p class="fr-text--lg" {{ lang_attr }}>{{ publisher.title | e }}</p>
        </div>
	{%- if download -%}
        <div class="fa-inventory-utils__eac_downloads">
          <div class="fr-col-12 fr-col-sm-8 fr-col-md-12">
            <a class="fr-link fr-link--download eulerian-button" href="{{ csv_props.url }}"
               download="true"
               {% if lang != "fr" -%}hreflang="fr"{% endif -%}
               {% if csv_props.target_blank %}
                   target="_blank" rel="noopener noreferrer nofollow"
               {% endif %}
               {% if csv_props.title %}title="{{ csv_props.title | e }}"{% endif %}
            >
              {{ csv_props.link }}
              <span class="fr-link__detail">CSV – {{ _('approximately') }} {{  csv_props.size }}</span>
            </a>
          </div>
          <div class="fr-col-12 fr-col-sm-8 fr-col-md-12 fr-pt-4v">
           <a class="fr-link fr-link--download eulerian-button" href="{{ eaccpf_props.url }}"
               download="true"
               {% if lang != "fr" -%}hreflang="fr"{% endif -%}
               {% if eaccpf_props.target_blank %}
                   target="_blank" rel="noopener noreferrer nofollow"
               {% endif %}
               {% if eaccpf_props.title %}title="{{ eaccpf_props.title | e }}"{% endif %}
            >
              {{ eaccpf_props.link }}
              <span class="fr-link__detail">XML – {{ _('approximately') }} {{  eaccpf_props.size }}</span>
            </a>
          </div>
        </div>
	{%- endif -%}
      </div>
    </div>
  </div>
  <div class="fr-pt-8v">
    {{ sharelinks(sharelinks_data, eulerian.document_title, "main_>_section_>_links", _) }}
  </div>
</section>
