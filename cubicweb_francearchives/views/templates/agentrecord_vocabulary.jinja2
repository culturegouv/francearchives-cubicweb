{% from "./mixins.jinja2" import mixed_values_horizontal, content_metadata, display_errors -%}
{%- set lang_attr='lang="{}"'.format(entity.lang) if entity.lang != lang else "" -%}
<div class="fr-container fr-py-6v">
  <div class="fr-grid-row fr-grid-row--gutters fr-grid-row--center">
    <div class="fr-col-12 fr-col-lg-8">
      <div id="{{ entity.cw_etype.lower() }}-{{ entity.eid }}">
        {{ display_errors(errors, _) }}
        
        <!-- Header -->
        <div class="fr-col-12 fr-mb-8v" {{ lang_attr }}>
          <h1 class="fr-h2 fr-mb-4v">{{ entity.dc_title() | e }}</h1>
        </div>
        
        <!-- Metadata -->
        <div class="fr-col-12 fr-mb-8v">
          {{ content_metadata(metadata, _) }}
        </div>
        
        <!-- Main Properties -->
        <div class="fr-col-12 fr-mb-8v">
          {%- if main_props | length > 0 -%}
          {{ mixed_values_horizontal(main_props, lang_attr, _) }}
          {%- else -%}
          <div class="fr-p-4v fr-background-alt--grey fr-radius">
            <p {{ lang_attr }}>{{ description }}</p>
          </div>
          {%- endif -%}
        </div>
      </div>
      
      <!-- Linked Agents Reference -->
      {%- if documents -%}
      <div class="fr-col-12 fr-mb-8v">
        {%- set label = _('linked_agent_ref') if (documents["total"] and documents["total"] > 1) == False else _('linked_agents_ref') -%}
        <h2 class="fr-h3 fr-mb-4v">{{ label }} <span class="fr-text--lg fr-text--grey">({{ documents["total"] }})</span></h2>
        
        {%- if documents["error"] -%}
        <div class="fr-alert fr-alert--error fr-my-4v">
          <p class="fr-text--bold">{{ documents["error"] }}</p>
        </div>
        {%- endif -%}
        
        {%- if documents["docs"] and documents["docs"] | length > 0 -%}
        <!-- Counter -->
        <div class="fr-mb-4v">
          {%- if documents["total"] and documents["total"] > 1  -%}
          <p class="fr-text--md fr-text--grey fr-mb-2v">
            <span class="fr-icon-information-line fr-icon--sm fr-mr-1v" aria-hidden="true"></span>
            {{ documents["total"] }} {{ label }}
            {%- if documents["total"] > 100 %}
            <span class="fr-ml-1v fr-tag fr-tag--sm">{{ documents["docs"] | length }} {{ _('affichées') }}</span>
            {%- endif -%}
          </p>
          {%- else -%}
          <p class="fr-text--md fr-text--grey fr-mb-2v">
            <span class="fr-icon-information-line fr-icon--sm fr-mr-1v" aria-hidden="true"></span>
            {{ documents["docs"] | length }} {{ label }}
          </p>
          {%- endif -%}
        </div>

        {%- if documents["total"] and documents["total"] > 100 -%}
        <p class="fr-text--md fr-text--grey fr-mb-4v">{{ _('Only display %s links.') % 100 }}</p>
        {%- endif -%}
        
        <!-- Simple list -->
        <ul class="fr-my-0 fr-pl-4v">
          {%- for doc in documents["docs"] -%}
          <li class="fr-my-2v">{{ doc }}</li>
          {%- endfor -%}
        </ul>
        {%- else -%}
        <!-- No linked documents -->
        <p class="fr-text--md fr-text--grey fr-mb-4v">{{ _('no_linked_agents_ref') }}</p>
        {%- endif -%}
      </div>
      {%- endif -%}

      <!-- Info Links -->
      {%- if info_links -%}
      <div class="fr-grid-row fr-grid-row--gutters">
        <div class="fr-col-12">
          <div class="fr-alert fr-alert--info fr-my-4v">
            <h3 class="fr-alert__title fr-text--bold fr-mb-2v">{{ _('More information') }}</h3>
            <ul class="fr-alert__desc fr-my-0">
              {% for label, url in info_links %}
              <li class="fr-my-2v">
                <a href="{{ url }}" class="fr-link fr-icon-arrow-right-line fr-link--icon-right" target="_blank" rel="noopener noreferrer">
                  {{ label }}
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
  </div>
</div>
