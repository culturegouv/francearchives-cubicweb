{% macro rdf_download_button(entity, rdf_formats, lang, _) %}
{%- set rdfid="rdfswitch"+ entity.eid|string -%}
<div class="fr-dropdown dropdown fr-mb-8v">
  <button class="fr-dropdown__btn fr-btn fr-btn--tertiary" aria-controls="{{ rdfid }}" aria-expanded="false">
    {{ _("Download the record in RDF") }}
  </button>
  <div class="fr-collapse fr-dropdown__menu fr-menu" id="{{ rdfid }}">
      <ul class="fr-menu__list">
        {{ rdf_download_options(entity, rdf_formats, lang, _) }}
      </ul>
   </div>
</div>
{%endmacro%}


{% macro rdf_download_button_tab(entity, rdf_formats, lang, _) %}
{%- set rdfid="rdfswitch"+ entity.eid|string -%}
<div class="fr-select-group fr-mb-8v">
  <p class="fr-label" id="{{ rdfid }}">{{_("Available RDF formats:") }}</p>
  <ul aria-labelledby="{{ rdfid }}">
  {{ rdf_download_options(entity, rdf_formats, lang, _) }}
  </ul>
</div>
{%endmacro%}

{% macro rdf_download_options(entity, rdf_formats, lang, _) %}
  {% for url, extension, name in rdf_formats %}
  <li>
  <a id="download-rdf-{{ extension}}-{{ entity.eid}}"
     class="fr-link fr-link--download {%- if eulerian %} eulerian-button{% endif -%}"
     download="{{ entity.rest_path().replace('/', '_') }}_rdf.{{ extension }}"
     {% if lang != "fr" -%}
     hreflang="fr"
     {% endif -%}
     href="{{ url }}"
     {%- if eulerian %}
     title="{{ _("Donwload in format") }}{{ _(":") }}{{ name }}"
     data-eulerian-actionname = "download_rdf_{{ heading_hierarchy }}"
     data-eulerian-actionlabel = "download_rdf,{{ eulerian.page_type }},{{ eulerian.type_doc }},{{ eulerian.document_title }}_rdf,{{ eulerian.service_code }}"
     data-eulerian-headinghierarchy="{{ heading_hierarchy }}"
     data-eulerian-componenthierarchy="main_>_section_>_list_>_link"
     data-eulerian-componentlabel="{{ eulerian.document_title }}"
            {% endif -%}
  >
    {{ name }}
    <span class="fr-link__detail">{{ name }} – {{ _('less than') }} 100 {{ _('KB') }}</span>

  </a>
  </li>
  {% endfor %}
{%endmacro%}


{% macro list(values, classes, lang_attr, _) %}
{% set seplist = _("; ") %}
<ul class="fr-links-group--inline fa-links-group--inline {%- if classes %} {{ classes }}{%- endif -%}">
    {% for value in values %}
    <li {{ lang_attr }}>{{ value |safe }}{%- if not loop.last %}{{ seplist }}{%- endif -%}</li>
    {% endfor %}
  </ul>
{% endmacro %}


{% macro imageitem(image, default_picto_src) %}
<figure class="fr-content-media" role="figure" {% if image.legend -%}aria-label="{{ image.legend }}" {%- endif -%}>
   <div class="fr-content-media__img">
      <img class="fr-responsive-img fr-ratio-16x9"
           src="{{ image.image_file[0].download_url() }}"
           alt="{{ image.alt  | escape }}"
           data-defaultsrc="{{ default_picto_src }}"
      >
   </div>
  {%- if image.legend -%}
  <figcaption class="fr-content-media__caption">{{ image.legend }}</figcaption>
  {%- endif -%}
</figure>
{% endmacro %}

{% macro imagelist(images, default_picto_src) %}
   {% for image in images %}
       {{ imageitem(image, default_picto_src) }}
   {% endfor %}
{% endmacro %}

{%- macro display_errors(errors, _) %}
  {%- if errors %}
    {%- for title, _errors in errors.items() %}
    {%- set data = _errors["errors"] %}
    {%- set css = "success" if data|length == 0 else "warning" %}
      <div class="alert alert-{{css}} fade show" role="alert">
        <h1>{{ title }}</h1>
        <p>{{ _errors["msg"] }}</p>
        {%- if data %}
        <table class="fr-table">
          <tr>
            <th>{{ _("link title") }} </th>
            <th>{{ _("broken link") }}</th>
            <th>{{ _("reason") }}</th>
          </tr>
          {%- for error in data %}
          <tr>
            <td>{{ error[0] }}</td><td>{{ error[1] }}</td><td>{{ error[2] }}</td>
          </tr>
          {%- endfor %}
        </table>
       {%- endif %}
      </div>
    {%- endfor %}
  {%- endif %}
{%- endmacro %}

{% macro faqitems(faq, category, editable, _, level) %}
{%- if faq -%}
<div class="fr-accordions-group">
{% for eid, faq_url, question, answer, qlang_attr, alang_attr in faq %}
<div class="fr-accordion">
  <h3 class="fr-accordion__title">
    <button class="fr-accordion__btn" aria-expanded="false" aria-controls="faq-{{ eid }}">
    {%- if qlang_attr -%}<span {{ qlang_attr }}>{{ question }}</span>
    {%- else -%}{{ question }}{%- endif -%}
    </button>
  </h3>
  <div class="fr-collapse" id="faq-{{ eid }}">
    {% if editable %}
      <p><a class="edit-link" href="{{ faq_url }}">{{ _('Edit the entry') }}</i></a></p>
    {% endif %}
    {%- if alang_attr -%}<div {{ alang_attr }}>{{ answer }}</div>
    {%- else -%}{{ answer }}{%- endif -%}
  </div>
</div>
{% endfor %}
</div>
{%- endif -%}
{% endmacro %}

{% macro modalbox_faq(data, boxid, _) %}
{% if data and data.faqs %}
<dialog aria-labelledby="{{ boxid }}-title" id="{{ boxid }}" class="fr-modal fr-modal--top">
    <div class="fr-container fr-container--fluid fr-container-md">
      <div class="fr-grid-row fr-grid-row--center">
        <div class="fr-col-12 fr-col-md-8 fr-col-lg-6">
          <div class="fr-modal__body">
            <div class="fr-modal__header">
              <button class="fr-btn--close fr-btn" aria-controls="{{ boxid }}">{{ _('Close') }}</button>
            </div>
            <div class="fr-modal__content">
              <h1 id="{{ boxid }}-title" class="fr-modal__title">
                <span class="fr-icon-arrow-right-line fr-icon--lg" aria-hidden="true"></span>
                {{ "FAQ" }} : {{ _(data.category) }}
              </h1>
              {{  faqitems(data.faqs, data.category, false, _, 2) }}
            </div>
            <div class="fr-modal__footer">
              <div class="fr-btns-group fr-btns-group--right fr-btns-group--inline-reverse fr-btns-group--inline-lg fr-btns-group--icon-left">
