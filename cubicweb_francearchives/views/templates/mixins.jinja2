{% macro on_front_page(entities, _) %}
{% if entities %}
{% for entity in entities %}
<div class="fr-col-12 fr-col-md-4">
  <div class="fr-card fr-card--sm fr-enlarge-link">
    <div class="fr-card__body{{ '' if entity.image else ' fr-mt-3w'}}">
      <div class="fr-card__content">
        <h3 class="fr-card__title" {% if entity.lang_attr -%}{{ entity.lang_attr }}{%- endif -%}>
          <a href="{{ entity.url }}">
          {{ entity.link_title | e }}
          </a>
        </h3>
        <p class="fr-card__desc" {% if entity.lang_attr -%}{{ entity.lang_attr }}{%- endif -%}>
         {{ entity.header| e}}
        </p>
        <p class="fr-badge fr-mb-6v">{{ entity.etype }}</p>
      </div>
    </div>
    {% if entity.image %}
    <div class="fr-card__header">
      <div class="fr-card__img">
        <img class="fr-responsive-img fr-ratio-16x9" src="{{ entity.image.image_file[0].download_url() }}"
             alt="{{ entity.image.alt|e }}" >
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% endfor %}
{% endif %}
{% endmacro %}

{% macro authority_props_horizontal(properties, _) %}
{% for label, values in properties %}
