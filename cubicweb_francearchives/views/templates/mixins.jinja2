{% macro table(data, _) %}
<div class="fr-table fr-table--bordered" id="table-default-component">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <thead>
            <tr>
            {%- for header in data[0] -%}
              <th scope="col">{{ header }}</th>
            {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            <tr>
            {%- for value in data[1] -%}
              <td>{{ value }}</td>
            {%- endfor -%}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endmacro %}
