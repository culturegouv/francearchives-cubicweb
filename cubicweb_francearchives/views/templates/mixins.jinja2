{% macro modalfaq(data, _) %}
{% if data and data.faqs %}
<div id="faqbox">
  <button class="fr-btn fr-btn--sm" data-fr-opened="false" aria-controls="faq-modal">
  {{ _("Help?") }}
  </button>
