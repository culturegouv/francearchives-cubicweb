   <div class="fr-grid-row fr-grid-row--gutters">
     <div class="fr-col-offset-md-3 fr-col-md-8 fr-col-offset-md-1--right fr-mt-2v">
       <p class="fr-text--sm">{{ _("source_info_label") }}{{ _(":") }}{{ values }}</p>
     </div>
   </div>
  {%- else -%}
  <div class="fr-grid-row fr-grid-row--gutters">
    <p class="fr-col-md-3 fr-my-0">{{ label.capitalize() }}</p>
    {%- if values | is_list -%}
    {{ list(values, "", "", _) }}
    {%- else -%}
      {%- if values[0] == '<' -%} {# accessibility #}
       <div class="fr-col-md-8 fr-mb-2v">{{ values  }}</div>
      {%- else -%}
       <p class="fr-col-md-8 fr-mb-2v">{{ values | safe }}</p>
