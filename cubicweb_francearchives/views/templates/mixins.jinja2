      <p class="fr-col-md-{{ col1 }} fr-mb-2v">{{ source}}{{ _(":") }}</p>
      {# we expect the first element to be the source #}
      <div class="fr-col-md-{{ col2 }}">
      {%- if values | is_list -%}
      {{ list(values, "", "", _) }}
      {%- else -%}
      {{ values | safe }}
      {%- endif -%}
      </div>
    </div>
    {%- endfor -%}
  </div>
{%- endfor -%}
{% endmacro %}

{% macro wikidata_links(properties, _) %}
{% set sep = _(":") %}
{% for propname, values in properties %}
<div class="fr-mb-10v">
<h2 class="fr-text--lead fr-mb-6v">{{ propname }}{{ sep }}</h2>
