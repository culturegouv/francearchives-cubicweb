{% macro service_props(properties, h, lang_attr, _) %}
{% for label, value in properties %}
   {% if value %}
     <div class="fr-grid-row fr-grid-row--gutters fr-mb-1v">
     {% if label is none %}
     <p {{ lang_attr }}> {{ value }}</p>
     {% else %}
       <h{{h+1}} class="fr-col-md-4 fr-text--md fr-text--bold fr-my-0">{{ label[0].upper() + label[1:] }}</h{{h+1}}>
       <p class="fr-col-md-8 fr-mb-2v" {{ lang_attr }}>{{ value }}</p>
     {% endif %}
     </div>
   {% endif %}
{% endfor %}
{% endmacro %}

{% macro toggle_map(entity, _) %}
{% set map_id = "service-map-" + entity.eid | string %}
<div class="fr-toggle fr-mt-2w">
  <input type="checkbox" class="fr-toggle__input" id="toggle-{{ map_id }}" tabindex="0">
  <label class="fr-toggle__label" for="toggle-{{ map_id }}" data-fr-checked-label="{{_('Enabled')}}" data-fr-unchecked-label="{{_('Disabled')}}">{{ _('Display the map') }}</label>
</div>
<div id="{{ map_id }}" class="fa-entity-map fa-service-map fr-hidden fr-mt-2w" data-index="{{ entity.eid }}" data-markerurl="{{ entity.properties.json_map_url }}" aria-hidden="true"></div>
{% endmacro %}


{% macro service_main_info(entity, h, lang_attr, _) %}
{%- set properties = entity.properties -%}
{% if properties.info %}
{{ service_props(properties.info, h, ang_attr, _) }}
{% endif %}
{%- if properties.note -%}
<div class="fr-my-6v fr-col-lg-10 fr-col-offset-lg-1" {{ lang_attr }}>
{{ properties.note }}
</div>
{%- endif -%}
{%- if entity.documents_links -%}
<div class="fr-my-6v fr-col-lg-10 fr-col-offset-lg-1">
  <ul class="fr-btns-group fr-btns-group--inline fa-btns--two-even fr-mt-10v fr-mb-4v">
  {%- for title, uri in entity.documents_links -%}
    <li><a href="{{ uri }}" class="fr-btn fr-btn--sm fr-btn--secondary fr-mb-xl-0">{{ title }}</a></li>
  {%- endfor -%}
  </ul>
</div>
{%- endif -%}
{% endmacro %}


{% macro service_info(entity, h, lang_attr,  _) %}
{%- set properties = entity.properties -%}
<div class="fr-col-12 fr-col-lg-10 fr-col-offset-lg-1">
  <div class="fr-tabs">
    <ul class="fr-tabs__list" role="tablist" aria-label="{{_("Service properties")}}">
      <li role="presentation">
      <button id="tabpanel-info-{{ entity.eid }}" class="fr-tabs__tab" tabindex="0" role="tab" aria-selected="true" aria-controls="tabpanel-info-panel-{{ entity.eid }}">{{ _("General information") }}</button>
    </li>
    <li role="presentation">
      <button id="tabpanel-rdf-{{ entity.eid }}" class="fr-tabs__tab" tabindex="-1" role="tab" aria-selected="false" aria-controls="tabpanel-rdf-panel-{{ entity.eid }}">{{_("Download RDF") }}</button>
    </li>
    </ul>
    <div id="tabpanel-info-panel-{{ entity.eid }}" class="fr-tabs__panel fr-tabs__panel--selected" role="tabpanel" aria-labelledby="tabpanel-info-{{ entity.eid }}" tabindex="0">
      <div class="fr-mt-2v fr-col-11 fr-col-sm-12">
      {{ service_main_info(entity, h, lang_attr, _) }}
      {%- if properties.json_map_url -%}{{ toggle_map(entity, _) }}{%- endif -%}
      </div>
    </div>
    <div id="tabpanel-rdf-panel-{{ entity.eid }}" class="fr-tabs__panel" role="tabpanel" aria-labelledby="tabpanel-rdf-{{ entity.eid }}" tabindex="0">
      {%- set heading_hierarchy = entity.eulerian.document_title -%}
       <div class="fr-col-11 fr-col-md-5 fr-col-lg-4">{{ rdf_download_button_tab(entity, entity.rdf_formats, properties.lang, _) }}</div>
    </div>
  </div>
</div>
{{ annex_services_accordeon(properties.related_entities, lang_attr, _) }}
{% endmacro %}

{% macro annex_services_accordeon(related_entities, lang_attr, _) %}
{%- if related_entities -%}
<div id="related-services">
  <h2 class="fr-mt-8w">{{ _("related_services_title") }}</h2>
  <div class="fr-accordions-group">
  {%- for linked_entity in related_entities -%}
  {%- set accordion_id = "service-" +  linked_entity.eid|string -%}
  {%- set accordion_header_id = "service-title-" +  linked_entity.eid|string -%}
    <div class="fr-accordion">
      <h3 class="fr-accordion__title">
        <button id="{{  accordion_header_id }}"
          class="fr-accordion__btn" aria-expanded="false" aria-controls="{{ accordion_id }}">
         {{ linked_entity.dc_title() }}
        </button>
      </h3>
      <section class="fr-collapse" id="{{ accordion_id }}"
        aria-labelledby="{{ accordion_header_id }}">
        <div class="fr-col-12 fr-mb-12v">
          {{ content_metadata(linked_entity.metadata, _) }}
        </div>
      {{ service_info(linked_entity, 3, lang_attr, _) }}
      </section>
    </div>
   {% endfor %}
  </div>
</div>
{%- endif -%}
{% endmacro %}


