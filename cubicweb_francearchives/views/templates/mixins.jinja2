{% macro translation_tool(links, _) %}
<nav role="navigation" class="fr-translate fr-nav">
  <div class="fr-nav__item">
    {% set lang, lang_code, url, title = links[0] -%}
    <button class="fr-translate__btn fr-btn fr-btn--tertiary"
            aria-controls="translate-toggle" aria-expanded="false"
            title="{{ lang_code.upper() }} -  {{ lang }} - {{ _("Select a language") }}">
            {{ lang }}
            <span class="fr-sr-only"> - {{ lang }}</span>
     </button>
     <div class="fr-collapse fr-translate__menu fr-menu" id="translate-toggle">
       <ul class="fr-menu__list">
         <li>
           <a class="fr-translate__language fr-nav__link"
              hreflang="{{ lang_code }}" lang="{{ lang_code }}"
              href="{{ url }}" aria-current="true">{{ lang_code.upper() }} - {{ lang }}</a>
         </li>
         {%- for lang, lang_code, url, title in links[1:] %}
         <li>
            <a class="fr-translate__language fr-nav__link
               hreflang="{{ lang_code }}" lang="{{ lang_code }}"
               href="{{ url }}">{{ lang_code.upper() }} - {{ lang }}</a>
         </li>
         {% endfor -%}
       </ul>
    </div>
  </div>
</nav>
{% endmacro %}

