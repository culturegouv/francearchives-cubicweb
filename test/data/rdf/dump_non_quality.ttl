# UNQUALIFIED_AR

<https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR#inst> a rico:Instantiation ;
    rico:identifier "UNQUALIFIED_AR" ;
    rico:isInstantiationOf <https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR> .

<https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR> a rico:Record ;
    rico:describesOrDescribed <https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR#agent> ;
    rico:hasDocumentaryForm ricoform:AuthorityRecord ;
    rico:hasInstantiation <https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR#inst> .

<https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR#agent> a rico:Agent,
        rico:Person ;
    rico:hasOrHadAgentName [ a rico:AgentName ;
            rico:isOrWasAgentNameOf <https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR#agent> ;
            rico:textualValue "Titi" ;
            rico:type "authorized" ] ;
    rico:isOrWasDescribedBy <https://testing.cubicweb/authorityrecord/UNQUALIFIED_AR> ;
    rico:name "Titi" .

