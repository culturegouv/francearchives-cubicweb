<https://testing.cubicweb/facomponent/unqualified-facomponent#record_resource_inst> a rico:Instantiation ;
    rico:hasOrHadHolder <https://testing.cubicweb/service/{{service_eid}}> ;
    rico:isInstantiationOf <https://testing.cubicweb/facomponent/unqualified-facomponent> .

<https://testing.cubicweb/facomponent/parent-facomponent> a rico:RecordResource ;
    rdfs:label "fcdid-title" ;
    rico:beginningDate "1234"^^xsd:gYear ;
    rico:endDate "1245"^^xsd:gYear ;
    rico:hasInstantiation <https://testing.cubicweb/facomponent/parent-facomponent#record_resource_inst> ;
    rico:hasOrHadManager <https://testing.cubicweb/service/{{service_eid}}> ;
    rico:history "fc-origination" ;
    rico:identifier "fcdid" ;
    rico:includesOrIncluded <https://testing.cubicweb/facomponent/qualified-facomponent> ;
    rico:isOrWasIncludedIn <https://testing.cubicweb/findingaid/FA-child-qualified> ;
    rico:isRecordResourceAssociatedWithRecordResource <https://testing.cubicweb/findingaid/FA-child-qualified> ;
    rico:scopeAndContent "fc-scoppecontent" ;
    rico:title "fcdid-title" .

