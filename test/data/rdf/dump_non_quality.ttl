# FA-unqualified

<https://testing.cubicweb/findingaid/FA-unqualified#record_inst1> a rico:Instantiation ;
    dcterms:format "text/csv" ;
    rdfs:seeAlso <https://testing.cubicweb/findingaid/FA-unqualified.csv> ;
    rico:isInstantiationOf <https://testing.cubicweb/findingaid/FA-unqualified#record> .

<https://testing.cubicweb/findingaid/FA-unqualified#record_resource_inst> a rico:Instantiation ;
    rico:hasOrHadHolder <https://testing.cubicweb/service/{{service_eid}}> ;
    rico:isInstantiationOf <https://testing.cubicweb/findingaid/FA-unqualified> ;
    rico:physicalCharacteristics "un beau rouleau" .

<https://testing.cubicweb/findingaid/FA-unqualified> a rico:RecordResource ;
    rdfs:label "maindid-title" ;
    rico:hasInstantiation <https://testing.cubicweb/findingaid/FA-unqualified#record_resource_inst> ;
    rico:hasOrHadManager <https://testing.cubicweb/service/{{service_eid}}> ;
    rico:identifier "maindid" ;
    rico:isOrWasDescribedBy <https://testing.cubicweb/findingaid/FA-unqualified#record> ;
    rico:title "maindid-title" .

<https://testing.cubicweb/findingaid/FA-unqualified#record> a rico:Record ;
    rico:describesOrDescribed <https://testing.cubicweb/findingaid/FA-unqualified> ;
    rico:hasDocumentaryFormType ricoform:FindingAid ;
    rico:hasInstantiation <https://testing.cubicweb/findingaid/FA-unqualified#record_inst1> ;
    rico:identifier "FRAD084_xxx" .

# parent-facomponent

<https://testing.cubicweb/facomponent/parent-facomponent#record_resource_inst> a rico:Instantiation ;
    rico:hasOrHadHolder <https://testing.cubicweb/service/{{service_eid}}> ;
