@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix ricoform: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#> .

<https://testing.cubicweb/agent/{{agent_eid}}> rico:isOrWasDescribedBy <https://testing.cubicweb/authorityrecord/A123> .

<https://testing.cubicweb/authorityrecord/A123#inst> a rico:Instantiation ;
    rico:hasOrHadHolder <https://testing.cubicweb/service/{{service_eid}}> ;
    rico:identifier "A123" ;
    rico:isInstantiationOf <https://testing.cubicweb/authorityrecord/A123> .

<https://testing.cubicweb/authorityrecord/A123> a rico:Record ;
    rico:describesOrDescribed <https://testing.cubicweb/agent/{{agent_eid}}> ;
    rico:hasCreator <https://testing.cubicweb/service/{{service_eid}}> ;
    rico:hasDocumentaryForm ricoform:AuthorityRecord ;
    rico:hasInstantiation <https://testing.cubicweb/authorityrecord/A123#inst> .
