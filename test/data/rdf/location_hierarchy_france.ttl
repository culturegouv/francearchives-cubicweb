@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://testing.cubicweb/location/{{toulouse}}> rico:containsOrContained <https://testing.cubicweb/location/{{capitole}}> .

<https://testing.cubicweb/location/{{france}}> rico:containsOrContained <https://testing.cubicweb/location/{{capitole}}> .

<https://testing.cubicweb/location/{{haute_garonne}}> rico:containsOrContained <https://testing.cubicweb/location/{{capitole}}> .

<https://testing.cubicweb/location/{{occitanie}}> rico:containsOrContained <https://testing.cubicweb/location/{{capitole}}> .

<https://testing.cubicweb/location/{{capitole}}> a rico:Place ;
    owl:sameAs <http://www.geonames.org/6301915> ;
    rico:isOrWasContainedBy <https://testing.cubicweb/location/{{toulouse}}>,
        <https://testing.cubicweb/location/{{france}}>,
        <https://testing.cubicweb/location/{{haute_garonne}}>,
        <https://testing.cubicweb/location/{{occitanie}}> ;
    rdfs:label "Capitole" ;
    rico:name "Capitole" .

