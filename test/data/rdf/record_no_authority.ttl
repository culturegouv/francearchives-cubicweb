@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix ricoform: <https://www.ica.org/standards/RiC/vocabularies/documentaryFormTypes#> .

<https://testing.cubicweb/authorityrecord/F234#inst> a rico:Instantiation ;
    rico:identifier "F234" ;
    rico:isInstantiationOf <https://testing.cubicweb/authorityrecord/F234> .

<https://testing.cubicweb/authorityrecord/F234> a rico:Record ;
    rico:describesOrDescribed <https://testing.cubicweb/authorityrecord/F234#agent> ;
    rico:hasDocumentaryForm ricoform:AuthorityRecord ;
    rico:hasInstantiation <https://testing.cubicweb/authorityrecord/F234#inst> .

<https://testing.cubicweb/authorityrecord/F234#agent> a rico:Agent,
        rico:Family ;
    rico:hasOrHadAgentName [ a rico:AgentName ;
            rico:isOrWasAgentNameOf <https://testing.cubicweb/authorityrecord/F234#agent> ;
            rico:textualValue "Famille Poulet" ;
            rico:type "authorized" ] ;
    rico:isOrWasDescribedBy <https://testing.cubicweb/authorityrecord/F234> ;
    rico:name "Famille Poulet" .

